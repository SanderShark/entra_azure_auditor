# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Real environment variables always take precedence over this file.
#
# Who reads this:
#   - the command line (`auditor run`, `auditor id ...`, `auditor group ...`, `auditor pim ...`): everything below;
#   - the desktop app (`auditor gui`): only AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_AUTHORITY_HOST, and only when
#     there is no tenants.json (see tenants.example.json). It always signs in as a user and never uses a secret;
#   - `auditor sync ...` reads none of it (it works on exported files and never signs in).

# --- Required ---------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Sign-in mode: app (unattended) | device | browser (as a user) -----------
# app     the app registration's own APPLICATION permissions; for the scheduled, read-only audit.
# device  / browser: you sign in; DELEGATED permissions, limited by your own roles. Needed for the identity
#         toolkit's PIM elevation (PIM activates roles for a person, not for an app).
AUDITOR_AUTH_MODE=app

# --- app mode only: pick ONE credential ---------------------------------------
# Option A: client secret (simplest; rotate it, and prefer B for anything real)
AZURE_CLIENT_SECRET=
# Option B: certificate (recommended). PEM file containing the PRIVATE key, plus the
# SHA-1 thumbprint shown in the portal after uploading the public .cer
# AZURE_CLIENT_CERT_PATH=/path/to/private-key.pem
# AZURE_CLIENT_CERT_THUMBPRINT=
# AZURE_CLIENT_CERT_PASSPHRASE=

# --- Optional: safety --------------------------------------------------------
# Command line: refuse every change and role activation (1 / true). The desktop app has a checkbox on its
# sign-in screen instead (and "read_only" per tenant in tenants.json).
# AUDITOR_READ_ONLY=1

# --- Optional: sign-in ---------------------------------------------------------
# Sovereign clouds, e.g. https://login.microsoftonline.us
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
# device/browser mode, audit commands: override the delegated READ scopes (space or comma separated)
# GRAPH_SCOPES=
# device/browser mode, toolkit commands and the desktop app: override the delegated WRITE scopes, for example
# to drop a capability you never use. Every scope listed must be consented on the app registration.
# AUDITOR_TOOLKIT_SCOPES=

# --- Optional: where things are kept (defaults shown) ----------------------------
# Saved audit runs
# AUDITOR_RUNS_DIR=~/.entra_auditor/runs
# Token cache for device/browser sign-in on the command line
# AUDITOR_TOKEN_CACHE=~/.entra_auditor/token_cache.json
# Local record of every change the toolkit makes and every recovery secret it shows (never the secret itself)
# AUDITOR_ACTION_LOG=~/.entra_auditor/actions.jsonl
# Desktop app: the folder holding tenants.json and one token cache per tenant...
# AUDITOR_CONFIG_DIR=~/.entra_auditor
# ...or the tenants file itself
# AUDITOR_TENANTS_FILE=~/.entra_auditor/tenants.json
