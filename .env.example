# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Real environment variables always take precedence over this file.

# --- Required ---------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Sign-in mode: app (unattended) | device | browser (as a user) -----------
AUDITOR_AUTH_MODE=app

# --- app mode: pick ONE credential -------------------------------------------
# Option A: client secret (simplest; rotate it, and prefer B for anything real)
AZURE_CLIENT_SECRET=
# Option B: certificate (recommended). PEM file containing the PRIVATE key, plus the
# SHA-1 thumbprint shown in the portal after uploading the public .cer
# AZURE_CLIENT_CERT_PATH=/path/to/private-key.pem
# AZURE_CLIENT_CERT_THUMBPRINT=
# AZURE_CLIENT_CERT_PASSPHRASE=

# --- Optional ----------------------------------------------------------------
# Sovereign clouds, e.g. https://login.microsoftonline.us
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
# user modes: override the delegated scopes (space or comma separated)
# GRAPH_SCOPES=
# Where saved runs and the user-mode token cache live
# AUDITOR_RUNS_DIR=~/.entra_auditor/runs
# AUDITOR_TOKEN_CACHE=~/.entra_auditor/token_cache.json
